   "source": [
    "import numpy as np\n",
    "from scipy.stats import norm   \n",
    "from scipy.integrate import quad"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def kl_divergence(p,q):\n",
    "    def integrand(x):\n",
    "        return p.pdf(x) * np.log(p.pdf(x) / q.pdf(x))\n",
    "    \n",
    "    return quad(integrand, *p.support())[0]"
   ]
  }
